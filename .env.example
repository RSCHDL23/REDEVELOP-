# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard > Project Settings > API).
# Leave these blank to run the app in DEMO MODE with sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The web address of the app. Used in sign-up and password reset emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Lets private document links (/d/...) open for agents who aren't on REschedule.
# Supabase → Project Settings → API → service_role key. Never put this in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
